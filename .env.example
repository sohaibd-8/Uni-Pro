TELEGRAM_BOT_TOKEN=
ADMIN_IDS=
DATABASE_PATH=unipro.db

POLL_INTERVAL_SECONDS=60
POLL_CONCURRENCY=5

# true = only deterministic Demo providers, no live websites.
# false = use enabled live read-only provider adapters below.
DEMO_MODE=true
ENABLE_ALIBABA=true
ENABLE_MRBILIT=true
ENABLE_SAFAR724=true
PROVIDER_TIMEOUT_SECONDS=8

HEALTH_PORT=8080
# PORT is optional; hosting platforms may inject it automatically.

MIN_TRANSFER_MINUTES=75
MAX_TRANSFER_WAIT_HOURS=12
ALT_SEARCH_EVERY_N_CYCLES=5
APP_TIMEZONE=Asia/Tehran
